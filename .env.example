# USB webcam index (0 = first camera)
CAMERA_INDEX=0

# Requested camera resolution (0 = use camera default)
# 1280x720 is better for license plates at the edges of the frame
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Inference device:
#   directml = GPU via DirectX 12 (Windows, no CUDA Toolkit needed) ← RECOMMENDED
#   cuda     = GPU via CUDA (requires CUDA Toolkit installed)
#   cpu      = CPU only
DEVICE=directml

# Face cosine similarity threshold (0.0–1.0)
FACE_THRESHOLD=0.5

# Face detection input size (320 = fast, 640 = accurate — default 320)
FACE_DET_SIZE=320

# MediaPipe pose model complexity (0 = lite/fast, 1 = default, 2 = accurate)
POSE_MODEL_COMPLEXITY=1

# License plate OCR confidence threshold (0.0–1.0)
# Lower value = more sensitive but more false positives
PLATE_CONFIDENCE_THRESHOLD=0.4

# YOLO detector confidence threshold for plate bounding boxes (0.0–1.0)
# Lower value = plates at corners / edges of the frame are easier to detect
PLATE_DETECTOR_CONF_THRESHOLD=0.3

# Duration (seconds) the last detected plate stays visible when OCR occasionally misses
# Eliminates flickering of the plate box. Set to 0 to disable.
PLATE_PERSIST_SECONDS=1.2

# Toggle each detector (true/false)
ENABLE_FACE=true
ENABLE_POSE=true
ENABLE_PLATE=true
